{
  "schema_version": 1,
  "quilt_loader": {
    "group": "${group}",
    "id": "${id}",
    "version": "${version}",
    "metadata": {
      "name": "${name}",
      "description": "${description}",
      "contributors": {
        "TheCritic": "Author",
        "bshuler": "Author"
      },
      "contact": {
        "homepage": "https://github.com/bshuler/critical-flight-details",
        "sources": "https://github.com/bshuler/critical-flight-details",
        "issues": "https://github.com/bshuler/critical-flight-details/issues"
      },
      "license": "MIT",
      "icon": "assets/flight_display/icon.png"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "client_init": [
        "net.critical.flight_display.FlightDisplayClient"
      ]
    },
    "depends": [
      {
        "id": "quilt_loader",
        "versions": ">=0.19.0"
      },
      {
        "id": "quilted_fabric_api",
        "versions": "*",
        "optional": true
      },
      {
        "id": "minecraft",
        "versions": "${minecraftVersion}"
      }
    ]
  },
  "mixin": "flight_display.mixins.json"
}
