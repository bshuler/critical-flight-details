{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",

  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "TheCritic",
    "bshuler"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_sources}",
    "issues": "${mod_issues}"
  },

  "license": "${mod_license}",
  "icon": "assets/flight_display/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "net.critical.flight_display.FlightDisplayClient"
    ]
  },
  "mixins": [
    "flight_display.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "~1.21",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*"
  }
}
