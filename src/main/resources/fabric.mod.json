{
  "schemaVersion": 1,
  "id": "flight_display",
  "version": "${version}",

  "name": "Critical Flight Display",
  "description": "Adds HUD for Elytra Flight with pitch indicator, speed display, and visual horizon lines",
  "authors": [
    "TheCritic",
    "bshuler"
  ],
  "contact": {
    "homepage": "https://github.com/bshuler/critical-flight-details",
    "sources": "https://github.com/bshuler/critical-flight-details",
    "issues": "https://github.com/bshuler/critical-flight-details/issues"
  },

  "license": "MIT",
  "icon": "assets/flight_display/icon.png",

  "environment": "client",
  "entrypoints": {
    "client": [
      "net.critical.flight_display.FlightDisplayClient"
    ]
  },
  "mixins": [
    "flight_display.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "~1.21",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*"
  }
}
